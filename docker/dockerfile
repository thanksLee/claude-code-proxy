FROM python:3.13-bullseye

RUN mkdir -p /app

WORKDIR /app

# 필요한 패키지 설치
RUN pip install uv

RUN apt-get update && apt-get install -y curl git ca-certificates

RUN git clone https://github.com/thanksLee/claude-code-proxy.git -b develop/ollama-docker

RUN cd claude-code-proxy && \
    uv sync

ENV VIRTUAL_ENV=/app/claude-code-proxy/.venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
ENV PYTHONPATH=/app/claude-code-proxy

WORKDIR /app/claude-code-proxy

CMD ["uv", "run", "uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8082", "--reload"]
